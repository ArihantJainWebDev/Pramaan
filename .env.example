# PRAMAAN Environment Variables
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Security / Key Storage Paths
# In production, these should be securely managed. For MVP, local directories.
KEYSTORE_DIR=./data/keystore
DB_PATH=./data/pramaan.sqlite

# Watermarking Parameters
WATERMARK_STRENGTH=10
WATERMARK_VERSION=1.0

# Hyperledger Fabric Settings
FABRIC_MSPID=Org1MSP
FABRIC_CERT_PATH=./fabric/network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=./fabric/network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/
FABRIC_TLS_CERT_PATH=./fabric/network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CHANNEL_NAME=pramaan-channel
FABRIC_CHAINCODE_NAME=provenance
